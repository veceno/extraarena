BOT_TOKEN=your_telegram_bot_token

# Main DB: DATABASE_URL has priority over DB_*.
DATABASE_URL=postgresql://user:password@localhost:5434/extraarena
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=
DB_NAME=extraarena

# Support funnel (separate bots and DB). Leave SUPPORT_ENABLED=false until tokens are configured.
SUPPORT_ENABLED=false
SUPPORT_TELEGRAM_BOT_TOKEN=
SUPPORT_MAX_BOT_TOKEN=
SUPPORT_MAX_WEBHOOK_SECRET=
SUPPORT_TELEGRAM_ADMIN_ID=
SUPPORT_MAX_ADMIN_ID=
# SUPPORT_DATABASE_URL has priority over SUPPORT_DB_*.
SUPPORT_DATABASE_URL=postgresql://user:password@localhost:5434/extraarena_support
SUPPORT_DB_HOST=localhost
SUPPORT_DB_PORT=5434
SUPPORT_DB_USER=postgres
SUPPORT_DB_PASSWORD=
SUPPORT_DB_NAME=extraarena_support

WEBAPP_URL=https://app.example.com
EXTRA_SHOP_URL=https://example.com
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8081
ENVIRONMENT=development
MCP_ENABLED=true
MATCH_STATE_BACKEND=memory
# Keep all web worker knobs at 1 while MATCH_STATE_BACKEND=memory.
# PvP matchmaking, active battles, sockets, pending invites, and bot tasks are process-local.
WEB_CONCURRENCY=1
AUTO_MIGRATE_ON_START=true

# Public beta/release: use ENVIRONMENT=production with WEBAPP_HOST=0.0.0.0
# strong unique JWT_SECRET + ADMIN_SESSION_SECRET values, and AUTO_MIGRATE_ON_START=false.
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_characters_here_abcdefghijklmnop
ADMIN_SESSION_SECRET=change_me_to_a_different_long_random_secret_at_least_64_characters_here_qrstuvwx
JWT_EXPIRY_DAYS=30

# Robokassa is the primary ruble provider when configured.
# Defaults are safe by environment: test mode is on only for ENVIRONMENT=development.
# For local payment testing set ROBOKASSA_TEST_MODE=true explicitly.
# Production refuses test mode unless ALLOW_PAYMENT_TEST_MODE=true is also set.
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_PASSWORD3=
ROBOKASSA_HASH_ALGO=SHA256
ROBOKASSA_TEST_MODE=false
ROBOKASSA_RESULT_URL=https://example.com/api/payments/robokassa/result
ROBOKASSA_SUCCESS_URL=https://example.com/extraShop/payment-success
ROBOKASSA_FAIL_URL=https://example.com/extraShop/payment-fail

# YooKassa is kept as the legacy/fallback ruble provider.
# For local payment testing set YOOKASSA_TEST_MODE=true explicitly.
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_TEST_MODE=false

RUSTORE_PUBLIC_TOKEN=
RUSTORE_CONSOLE_APP_ID=2063712624
RUSTORE_KEY_ID=
RUSTORE_PRIVATE_KEY=
RUSTORE_PRIVATE_KEY_FILE=
RUSTORE_SANDBOX=false
RUSTORE_APP_URL=https://www.rustore.ru/catalog/app/ru.extraarena.app
PAYMENT_PRIMARY_PROVIDER=robokassa
PAYMENT_FALLBACK_PROVIDER=yookassa
PAYMENT_PROVIDER_ORDER=robokassa,yookassa,rustore,stars
PAYMENTS_REQUIRED=false
ALLOW_PAYMENT_TEST_MODE=false

STARS_RATE_RUB=1.8
STARS_MARKUP=1.15
STARS_TEST_MODE=false

# Shop
# false blocks buying particles for cards already at max level.
SHOP_ALLOW_MAX_LEVEL_PARTICLES=false

OPENAI_API_KEY=your_openai_or_yandex_api_key

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@extraarena.gg
IP_GEO_API_KEY=

